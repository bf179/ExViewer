+// ===== 批量收藏（B4）：app 级后台执行 + Room 进度持久化 =====
+
+const val BATCH_STATUS_RUNNING = "运行中"
+const val BATCH_STATUS_DONE = "完成"
+const val BATCH_STATUS_FAILED = "失败"
+const val BATCH_STATUS_INTERRUPTED = "中断"
+
+// app 级作用域：离开列表页 / 切页都不中断
+private val batchFavScope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+
+object BatchFavController {
+    @Volatile
+    var job: Job? = null
+}
+
+private suspend fun batchToast(msg: String) = withContext(Dispatchers.Main) {
+    Toast.makeText(appCtx, msg, Toast.LENGTH_SHORT).show()
+}
+
+// 批量逐项收藏：只做「添加」语义，已收藏判定由调用方完成
+suspend fun batchModifyFavorite(galleryInfo: BaseGalleryInfo) {
+    val localFavorited = EhDB.containLocalFavorites(galleryInfo.gid)
+    val slot = if (!Settings.hasSignedIn.value) {
+        LOCAL_FAVORITED
+    } else {
+        val defaultFavSlot = Settings.defaultFavSlot.value
+        // 批量场景不弹「每次询问」对话框，回退到本地收藏
+        if (defaultFavSlot == -2) LOCAL_FAVORITED else defaultFavSlot
+    }
+    doModifyFavorites(galleryInfo, slot, localFavorited)
+}
+
+fun startBatchFav(items: List<BaseGalleryInfo>) {
+    if (BatchFavController.job?.isActive == true) return
+    BatchFavController.job = batchFavScope.launch {
+        val dao = EhDB.batchFavTaskDao()
+        val now = System.currentTimeMillis()
+        val id = dao.insert(
+            BatchFavTask(status = BATCH_STATUS_RUNNING, total = items.size, done = 0, createdAt = now, updatedAt = now),
+        )
+        runBatchFavLoop(items, id, items.size, now)
+    }
+}
+
+// 续跑：重置进度重新执行，已收藏者跳过并计入成功（不会重复收藏/误删）
+fun resumeBatchFav(items: List<BaseGalleryInfo>, task: BatchFavTask) {
+    if (BatchFavController.job?.isActive == true) return
+    BatchFavController.job = batchFavScope.launch {
+        val dao = EhDB.batchFavTaskDao()
+        dao.update(task.copy(status = BATCH_STATUS_RUNNING, done = 0, updatedAt = System.currentTimeMillis()))
+        runBatchFavLoop(items, task.id, task.total, task.createdAt)
+    }
+}
+
+// 手动中止：只取消剩余部分，已处理进度保留供续跑
+fun cancelBatchFav() {
+    BatchFavController.job?.cancel(CancellationException("手动中止"))
+}
+
+private suspend fun runBatchFavLoop(items: List<BaseGalleryInfo>, taskId: Long, total: Int, createdAt: Long) {
+    val dao = EhDB.batchFavTaskDao()
+    val slowFav = Settings.defaultFavSlot.value != -1
+    var successCount = 0
+    // 取消后 Room suspend 写入会立刻抛 CancellationException，用 NonCancellable 保证进度落盘
+    suspend fun updateTask(status: String, done: Int) = withContext(NonCancellable) {
+        dao.update(
+            BatchFavTask(
+                id = taskId,
+                status = status,
+                total = total,
+                done = done,
+                createdAt = createdAt,
+                updatedAt = System.currentTimeMillis(),
+            ),
+        )
+    }
+    try {
+        items.forEach { galleryInfo ->
+            currentCoroutineContext().ensureActive()
+            // 已收藏判定：实时 favoriteSlot + 本地库双查，避免误删
+            val isFavorited = galleryInfo.favoriteSlot != NOT_FAVORITED || EhDB.containLocalFavorites(galleryInfo.gid)
+            if (!isFavorited) {
+                runSuspendCatching { batchModifyFavorite(galleryInfo) }.onSuccess { successCount++ }
+                if (slowFav) delay(4000)
+                delay(100)
+            } else {
+                successCount++
+            }
+            updateTask(BATCH_STATUS_RUNNING, successCount)
+        }
+        updateTask(BATCH_STATUS_DONE, successCount)
+        batchToast("成功收藏 $successCount/$total 个画廊")
+    } catch (e: CancellationException) {
+        updateTask(BATCH_STATUS_INTERRUPTED, successCount)
+        batchToast("任务中止，已处理收藏 $successCount 个画廊")
+        throw e
+    } catch (e: Exception) {
+        updateTask(BATCH_STATUS_FAILED, successCount)
+        batchToast("批量收藏失败: ${e.message}")
+    }
+}

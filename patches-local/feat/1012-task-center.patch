+/**
+ * 任务中心：批量收藏等后台任务的进度、取消、删除与排队。
+ *
+ * 同一时刻只跑一个批量任务，其余按加入顺序排队（`BatchFavController`）。
+ */
+@Destination<RootGraph>
+@Composable
+fun AnimatedVisibilityScope.TasksScreen(navigator: DestinationsNavigator) = Screen(navigator) {
+    val scrollBehavior = TopAppBarDefaults.pinnedScrollBehavior()
+    val tasks by EhDB.batchFavTaskDao().listFlow().collectAsState(emptyList())
+    val timeFormat = SimpleDateFormat("MM-dd HH:mm", Locale.getDefault())
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text(text = "任务中心") },
+                navigationIcon = { NavigationIcon() },
+                actions = {
+                    IconButton(onClick = { clearFinishedBatchTasks() }) {
+                        Icon(imageVector = Icons.Default.Delete, contentDescription = "清空已完成")
+                    }
+                },
+                scrollBehavior = scrollBehavior,
+            )
+        },
+    ) { paddingValues ->
+        LazyColumn(
+            modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+            contentPadding = paddingValues,
+        ) {
+            if (tasks.isEmpty()) {
+                item {
+                    Text(
+                        text = "暂无任务。批量收藏时若已有任务在跑，新任务会自动排队。",
+                        modifier = Modifier.padding(24.dp),
+                        style = MaterialTheme.typography.bodyMedium,
+                    )
+                }
+            }
+            items(tasks, key = { it.id }) { task ->
+                TaskRow(task = task, timeText = timeFormat.format(Date(task.createdAt)))
+            }
+        }
+    }
+}
+
+@Composable
+private fun TaskRow(task: BatchFavTask, timeText: String) {
+    val active = task.status == BATCH_STATUS_RUNNING || task.status == BATCH_STATUS_QUEUED
+    ListItem(
+        headlineContent = { Text(text = "批量收藏 · ${task.status}") },
+        supportingContent = {
+            Column(verticalArrangement = Arrangement.spacedBy(2.dp)) {
+                Text(text = "进度 ${task.done}/${task.total} · $timeText")
+                if (task.status == BATCH_STATUS_CANCELLED || task.status == BATCH_STATUS_FAILED) {
+                    Text(
+                        text = "在画廊列表重新选中条目后批量收藏即可重跑",
+                        style = MaterialTheme.typography.bodySmall,
+                    )
+                }
+            }
+        },
+        trailingContent = {
+            Row(verticalAlignment = androidx.compose.ui.Alignment.CenterVertically) {
+                if (active) {
+                    TextButton(onClick = { cancelBatchTask(task.id) }) { Text(text = "取消") }
+                } else {
+                    TextButton(onClick = { deleteBatchTask(task.id) }) { Text(text = "删除") }
+                }
+            }
+        },
+        modifier = Modifier.fillMaxWidth(),
+    )
+}

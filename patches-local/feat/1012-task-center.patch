+/** 任务中心：取消任务（排队中则移出队列并标记已取消；运行中则中止） */
+fun cancelBatchTask(id: Long) {
+    batchFavScope.launch {
+        val dao = EhDB.batchFavTaskDao()
+        if (BatchFavController.queuedIds().contains(id)) {
+            BatchFavController.remove(id)
+            dao.getById(id)?.let { dao.update(it.copy(status = BATCH_STATUS_CANCELLED, updatedAt = System.currentTimeMillis())) }
+        } else if (BatchFavController.currentTaskId == id) {
+            cancelBatchFav()
+        }
+    }
+}
+
+/** 任务中心：删除任务记录 */
+fun deleteBatchTask(id: Long) {

+import kotlinx.coroutines.launch
+
+/**
+ * 下载优先队列页：展示 priority_queue 里的单画廊（你阅读时精选、要优先下载的）。
+ * 排序：加入时间（默认）/ 近期更新；支持正倒序。
+ * 二级入口：优先订阅（feed_item）。
+ */
+@Destination<RootGraph>
+@Composable
+fun AnimatedVisibilityScope.DownloadPriorityScreen(navigator: DestinationsNavigator) = Screen(navigator) {
+    val scrollBehavior = TopAppBarDefaults.pinnedScrollBehavior()
+    val scope = rememberCoroutineScope()
+    val items = remember { mutableStateListOf<ExlClient.PriorityItem>() }
+    var page by remember { mutableStateOf(0) }
+    var sortByUpdated by remember { mutableStateOf(false) }
+    var desc by remember { mutableStateOf(true) }
+    var loading by remember { mutableStateOf(false) }
+    var total by remember { mutableStateOf(0) }
+
+    suspend fun load(reset: Boolean) {
+        if (loading) return
+        loading = true
+        val p = if (reset) 0 else page
+        val (list, t) = ExlClient.pqList(
+            page = p,
+            sort = if (sortByUpdated) "updated" else "added",
+            desc = desc,
+            hideFav = false,
+        )
+        if (reset) items.clear()
+        items.addAll(list.filter { new -> items.none { it.gid == new.gid } })
+        total = t
+        page = p + 1
+        loading = false
+    }
+
+    LaunchedEffect(sortByUpdated, desc) { load(reset = true) }
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text("下载优先 · $total") },
+                navigationIcon = { NavigationIcon() },
+                actions = {
+                    IconButton(onClick = { sortByUpdated = !sortByUpdated }) {
+                        Icon(Icons.Default.Sort, contentDescription = if (sortByUpdated) "按近期更新" else "按加入时间")
+                    }
+                    IconButton(onClick = { desc = !desc }) {
+                        Icon(Icons.Default.SwapVert, contentDescription = if (desc) "倒序" else "正序")
+                    }
+                    IconButton(onClick = { navigator.navigate(FeedSubScreenDestination()) }) {
+                        Icon(Icons.Default.Subscriptions, contentDescription = "优先订阅")
+                    }
+                },
+                scrollBehavior = scrollBehavior,
+            )
+        },
+    ) { padding ->
+        LazyColumn(
+            modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+            contentPadding = padding,
+        ) {
+            item(key = "head") {
+                Text(
+                    text = if (sortByUpdated) "排序：近期更新（${if (desc) "↓" else "↑"}）" else "排序：加入时间（${if (desc) "↓" else "↑"}）",
+                    style = MaterialTheme.typography.labelMedium,
+                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 6.dp),
+                )
+            }
+            items(items, key = { it.gid }) { item ->
+                Column(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .clickable { navigator.navigate(item.displayGid asDstWith item.displayToken) }
+                        .padding(horizontal = 16.dp, vertical = 8.dp),
+                    verticalArrangement = Arrangement.spacedBy(2.dp),
+                ) {
+                    Text(
+                        text = item.title ?: item.title_jpn ?: "#${item.gid}",
+                        maxLines = 2,
+                        overflow = TextOverflow.Ellipsis,
+                        style = MaterialTheme.typography.bodyMedium,
+                    )
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        Text(
+                            text = listOfNotNull(
+                                item.uploader?.takeIf { it.isNotBlank() },
+                                item.category,
+                                "${item.filecount}P",
+                            ).joinToString(" · "),
+                            style = MaterialTheme.typography.bodySmall,
+                            maxLines = 1,
+                            overflow = TextOverflow.Ellipsis,
+                        )
+                    }
+                    val badges = buildList {
+                        if (item.replaced) add("↻ 新版")
+                        if (item.expunged == 1) add("已下架")
+                        if (item.downloadedLatest > 0) add("已下载") else if (item.isfin == 1) add("已下 · 旧版")
+                    }
+                    if (badges.isNotEmpty()) {
+                        Text(
+                            text = badges.joinToString("  "),
+                            style = MaterialTheme.typography.labelSmall,
+                            color = MaterialTheme.colorScheme.primary,
+                        )
+                    }
+                }
+                HorizontalDivider()
+            }
+            item(key = "more") {
+                Row(
+                    modifier = Modifier.fillMaxWidth().padding(16.dp),
+                    horizontalArrangement = Arrangement.Center,
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    Text(
+                        text = if (loading) "加载中…" else if (items.size >= total) "已全部加载" else "加载更多",
+                        modifier = Modifier.clickable(enabled = !loading && items.size < total) {
+                            scope.launch { load(reset = false) }
+                        },
+                    )
+                }
+            }
+        }
+    }
+}
+

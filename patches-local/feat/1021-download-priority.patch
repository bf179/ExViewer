+/**
+ * 优先订阅页：下载优先队列里 type=tag 的标签定期抓取结果。
+ * 顶部是订阅管理（开关/删除/新增），下面是新作品流。
+ */
+@Destination<RootGraph>
+@Composable
+fun AnimatedVisibilityScope.FeedSubScreen(navigator: DestinationsNavigator) = Screen(navigator) {
+    val scrollBehavior = TopAppBarDefaults.pinnedScrollBehavior()
+    val scope = rememberCoroutineScope()
+    val subs = remember { mutableStateListOf<ExlClient.FeedSub>() }
+    val items = remember { mutableStateListOf<ExlClient.FeedItem>() }
+    var page by remember { mutableStateOf(0) }
+    var loading by remember { mutableStateOf(false) }
+    var showAdd by remember { mutableStateOf(false) }
+
+    suspend fun reloadSubs() {
+        subs.clear()
+        subs.addAll(ExlClient.feedSubs())
+    }
+
+    suspend fun load(reset: Boolean) {
+        if (loading) return
+        loading = true
+        val p = if (reset) 0 else page
+        val list = ExlClient.feedList(page = p, hideFav = true)
+        if (reset) items.clear()
+        items.addAll(list.filter { new -> items.none { it.gid == new.gid } })
+        page = p + 1
+        loading = false
+    }
+
+    LaunchedEffect(Unit) {
+        reloadSubs()
+        load(reset = true)
+    }
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text("优先订阅") },
+                navigationIcon = { NavigationIcon() },
+                actions = {
+                    IconButton(onClick = { showAdd = true }) {
+                        Icon(Icons.Default.Add, contentDescription = "新增订阅")
+                    }
+                    IconButton(onClick = { scope.launch { reloadSubs(); load(reset = true) } }) {
+                        Icon(Icons.Default.Refresh, contentDescription = "刷新")
+                    }
+                },
+                scrollBehavior = scrollBehavior,
+            )
+        },
+    ) { padding ->
+        LazyColumn(
+            modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+            contentPadding = padding,
+        ) {
+            item(key = "subs_head") {
+                Text(
+                    text = "订阅（${subs.size}）",
+                    style = MaterialTheme.typography.labelMedium,
+                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 6.dp),
+                )
+            }
+            items(subs, key = { "sub_${it.id}" }) { sub ->
+                Row(
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 4.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    Column(modifier = Modifier.weight(1f)) {
+                        Text(sub.tag, maxLines = 1, overflow = TextOverflow.Ellipsis)
+                        Text(
+                            text = "${sub.kind} · 每页 ${sub.pageLimit} · ${sub.lastRunAt ?: "未跑过"}",
+                            style = MaterialTheme.typography.bodySmall,
+                        )
+                    }
+                    Switch(
+                        checked = sub.enabled == 1,
+                        onCheckedChange = { on ->
+                            scope.launch {
+                                ExlClient.feedSubUpsert(sub.kind, sub.tag, on, sub.pageLimit)
+                                reloadSubs()
+                            }
+                        },
+                    )
+                    IconButton(onClick = {
+                        scope.launch {
+                            ExlClient.feedSubDelete(sub.id)
+                            reloadSubs()
+                        }
+                    }) {
+                        Icon(Icons.Default.Delete, contentDescription = "删除订阅")

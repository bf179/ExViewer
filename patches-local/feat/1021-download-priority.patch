+            }
+        }
+    }
+
+    if (showAdd) {
+        val tagState = rememberTextFieldState()
+        AlertDialog(
+            onDismissRequest = { showAdd = false },
+            title = { Text("新增订阅标签") },
+            text = {
+                OutlinedTextField(
+                    state = tagState,
+                    label = { Text("标签，如 artist:xxx / group:yyy") },
+                    lineLimits = TextFieldLineLimits.SingleLine,
+                )
+            },
+            confirmButton = {
+                TextButton(onClick = {

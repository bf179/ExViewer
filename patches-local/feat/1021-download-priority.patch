+package com.hippo.ehviewer.client
+
+import com.hippo.ehviewer.EhApplication
+import com.hippo.ehviewer.Settings
+import io.ktor.client.call.body
+import io.ktor.client.request.header
+import io.ktor.client.request.post
+import io.ktor.client.request.setBody
+import io.ktor.http.ContentType
+import io.ktor.http.content.TextContent
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.add
+import kotlinx.serialization.json.buildJsonArray
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+
+/**
+ * ExL 服务端单一端点客户端：POST {base}/api，body 里带 action。
+ *
+ * 设计文档见 EXL-SYSTEM.md §4。旧路径（/pq_galleries 等）保留在服务端做兼容别名。
+ */
+object ExlClient {
+    private val json = Json {
+        ignoreUnknownKeys = true
+        coerceInputValues = true
+        explicitNulls = false
+    }
+
+    /** 从 pq_url（历史配置是 .../pq_galleries）推导出 /api 地址 */
+    fun apiUrl(): String {
+        val raw = Settings.pqUrl.value?.trim().orEmpty()
+        if (raw.isEmpty()) return ""
+        val cut = raw.indexOf("/pq_galleries")
+        val root = if (cut > 0) raw.substring(0, cut) else raw.trimEnd('/')
+        return root.trimEnd('/') + "/api"
+    }
+
+    suspend fun call(action: String, payload: JsonObject = buildJsonObject { }): JsonObject? {
+        val url = apiUrl()
+        if (url.isEmpty()) return null
+        val body = buildJsonObject {
+            put("action", action)
+            payload.forEach { (k, v) -> put(k, v) }
+        }
+        val resp: String = runCatching {
+            EhApplication.ktorClient.post(url) {
+                val token = Settings.apiToken.value
+                if (!token.isNullOrBlank()) header("Authorization", "Bearer $token")
+                setBody(TextContent(body.toString(), ContentType.Application.Json))
+            }.body()
+        }.getOrNull() ?: return null
+        return runCatching { json.parseToJsonElement(resp).jsonObject }.getOrNull()
+    }
+
+    private fun JsonObject.data(): JsonObject? = runCatching { this["data"]!!.jsonObject }.getOrNull()
+
+    // ===== 下载优先队列 =====
+
+    @Serializable
+    data class PriorityItem(
+        val gid: Long = 0,
+        val token: String = "",
+        val title: String? = null,
+        val title_jpn: String? = null,
+        val thumb: String? = null,
+        val category: String? = null,
+        val uploader: String? = null,
+        val posted: Long = 0,
+        val filecount: Int = 0,
+        val filesize: Long = 0,
+        val rating: Float = 0f,
+        val expunged: Int = 0,
+        val fav_status: Int = 0,
+        @SerialName("display_gid") val displayGid: Long = 0,
+        @SerialName("display_token") val displayToken: String = "",
+        val replaced: Boolean = false,
+        @SerialName("downloaded_latest") val downloadedLatest: Int = 0,
+        val isfin: Int = 0,
+        val content: String = "",
+    )
+
+    suspend fun pqList(page: Int, pageSize: Int = 30, sort: String = "added", desc: Boolean = true, hideFav: Boolean): Pair<List<PriorityItem>, Int> {
+        val obj = call("pq_list", buildJsonObject {
+            put("page", page)
+            put("page_size", pageSize)
+            put("sort", sort)
+            put("order", if (desc) "desc" else "asc")
+            put("hide_fav", if (hideFav) 1 else 0)
+        })?.data() ?: return emptyList<PriorityItem>() to 0
+        val items = runCatching {
+            obj["items"]!!.jsonArray.map { json.decodeFromJsonElement(PriorityItem.serializer(), it) }
+        }.getOrDefault(emptyList())
+        val total = runCatching { obj["total"]!!.jsonPrimitive.intOrNull ?: items.size }.getOrDefault(items.size)
+        return items to total
+    }
+
+    suspend fun pqAdd(icontent: String, itype: String = "gallery"): Boolean {
+        val obj = call("pq_add", buildJsonObject {
+            put("itype", itype)
+            put("icontent", icontent)
+        }) ?: return false
+        return obj["ok"]?.jsonPrimitive?.contentOrNull == "true"
+    }
+
+    // ===== 优先订阅 =====
+
+    @Serializable
+    data class FeedItem(
+        val gid: Long = 0,
+        val token: String = "",
+        val title: String? = null,
+        val title_jpn: String? = null,
+        val thumb: String? = null,
+        val category: String? = null,
+        val uploader: String? = null,
+        val posted: Long = 0,
+        val filecount: Int = 0,
+        val filesize: Long = 0,
+        val rating: Float = 0f,
+        val expunged: Int = 0,
+        val fav_status: Int = 0,
+        @SerialName("sub_id") val subId: Int = 0,
+        @SerialName("first_seen_at") val firstSeenAt: String? = null,
+        @SerialName("display_gid") val displayGid: Long = 0,
+        @SerialName("display_token") val displayToken: String = "",
+        val replaced: Boolean = false,
+    )
+
+    suspend fun feedList(page: Int, pageSize: Int = 30, subId: Int? = null, hideFav: Boolean): List<FeedItem> {
+        val obj = call("feed_list", buildJsonObject {
+            put("page", page)
+            put("page_size", pageSize)
+            if (subId != null) put("sub_id", subId)
+            put("hide_fav", if (hideFav) 1 else 0)
+            put("hide_translated", 1)
+        })?.data() ?: return emptyList()
+        return runCatching {
+            obj["items"]!!.jsonArray.map { json.decodeFromJsonElement(FeedItem.serializer(), it) }
+        }.getOrDefault(emptyList())
+    }
+
+    @Serializable
+    data class FeedSub(
+        val id: Int = 0,
+        val kind: String = "pq_tag",
+        val tag: String = "",
+        val enabled: Int = 1,
+        @SerialName("page_limit") val pageLimit: Int = 3,
+        @SerialName("last_run_at") val lastRunAt: String? = null,
+    )
+
+    suspend fun feedSubs(): List<FeedSub> {
+        val obj = call("feed_sub", buildJsonObject { put("op", "list") })?.data()
+        val arr = runCatching { obj!!.jsonArray }.getOrNull() ?: return emptyList()
+        return arr.mapNotNull { runCatching { json.decodeFromJsonElement(FeedSub.serializer(), it) }.getOrNull() }
+    }
+
+    suspend fun feedSubUpsert(kind: String, tag: String, enabled: Boolean = true, pageLimit: Int = 3): Boolean {
+        val obj = call("feed_sub", buildJsonObject {
+            put("op", "upsert")
+            put("kind", kind)
+            put("tag", tag)
+            put("enabled", if (enabled) 1 else 0)
+            put("page_limit", pageLimit)
+        }) ?: return false
+        return obj["ok"]?.jsonPrimitive?.contentOrNull == "true"
+    }
+
+    suspend fun feedSubDelete(id: Int): Boolean {
+        val obj = call("feed_sub", buildJsonObject {
+            put("op", "delete")
+            put("id", id)
+        }) ?: return false
+        return obj["ok"]?.jsonPrimitive?.contentOrNull == "true"
+    }
+
+    // ===== 来源索引 =====
+
+    /** 拉 pq / feed 的 gid 集合，写入本地 gallery_origin 快捷副本。 */
+    suspend fun origins(kinds: List<String> = listOf("pq", "feed", "expunged")): Map<String, List<Int>> {
+        val obj = call("origins", buildJsonObject {
+            put("kinds", buildJsonArray { kinds.forEach { add(it) } })
+        })?.data() ?: return emptyMap()
+        return obj.mapValues { (_, v) ->
+            runCatching { v.jsonArray.mapNotNull { it.jsonPrimitive.intOrNull } }.getOrDefault(emptyList())
+        }
+    }
+
+    // ===== 版本 =====
+
+    suspend fun versionSince(ts: Long): List<JsonObject> {
+        val obj = call("version_since", buildJsonObject { put("ts", ts) })?.data() ?: return emptyList()
+        return runCatching { obj["items"]!!.jsonArray.map { it.jsonObject } }.getOrDefault(emptyList())
+    }
+}
+

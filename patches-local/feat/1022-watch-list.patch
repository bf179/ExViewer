+private val KINDS = listOf("artist" to "艺术家", "circle" to "社团", "tag" to "标签", "title" to "标题", "group" to "其他")
+
+/**
+ * 关注列表管理：按类型分组、单个/批量开关、删除、新增。
+ */
+@Destination<RootGraph>
+@Composable
+fun AnimatedVisibilityScope.WatchListScreen(navigator: DestinationsNavigator) = Screen(navigator) {
+    val scrollBehavior = TopAppBarDefaults.pinnedScrollBehavior()
+    val scope = rememberCoroutineScope()
+    val items = remember { mutableStateListOf<WatchItem>() }
+    var kindFilter by remember { mutableStateOf<String?>(null) }
+    var showAdd by remember { mutableStateOf(false) }
+
+    suspend fun reload() {
+        items.clear()
+        items.addAll(EhDB.watchItemDao().listFlow().first())
+    }
+
+    LaunchedEffect(Unit) { reload() }
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text("关注列表") },
+                navigationIcon = { NavigationIcon() },
+                actions = {
+                    TextButton(onClick = {
+                        scope.launch {
+                            EhDB.watchItemDao().setAllEnabled(true)
+                            reload()
+                        }
+                    }) { Text("全开") }
+                    TextButton(onClick = {
+                        scope.launch {
+                            EhDB.watchItemDao().setAllEnabled(false)
+                            reload()
+                        }
+                    }) { Text("全关") }
+                    IconButton(onClick = { navigator.navigate(WatchFeedScreenDestination()) }) {
+                        Icon(Icons.Default.Add, contentDescription = "打开关注页")
+                    }
+                },
+                scrollBehavior = scrollBehavior,
+            )
+        },
+        floatingActionButton = {
+            androidx.compose.material3.ExtendedFloatingActionButton(
+                onClick = { showAdd = true },
+                icon = { Icon(Icons.Default.Add, contentDescription = null) },
+                text = { Text("新增关注") },
+            )
+        },
+    ) { padding ->
+        LazyColumn(
+            modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+            contentPadding = padding,
+        ) {
+            item(key = "chips") {
+                Row(
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 6.dp),
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    FilterChip(selected = kindFilter == null, onClick = { kindFilter = null }, label = { Text("全部") })
+                    KINDS.forEach { (k, label) ->
+                        FilterChip(
+                            selected = kindFilter == k,
+                            onClick = { kindFilter = if (kindFilter == k) null else k },
+                            label = { Text(label) },
+                        )
+                    }
+                }
+            }
+            val shown = items.filter { kindFilter == null || it.kind == kindFilter }
+            items(shown, key = { it.id }) { w ->
+                Row(
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 6.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    Column(modifier = Modifier.weight(1f)) {
+                        Text(text = w.content, maxLines = 1, overflow = TextOverflow.Ellipsis)
+                        Text(
+                            text = kindLabel(w.kind) + (w.category?.let { " · $it" } ?: ""),
+                            style = MaterialTheme.typography.bodySmall,
+                            maxLines = 1,
+                        )
+                    }
+                    Switch(
+                        checked = w.enabled,
+                        onCheckedChange = { on ->
+                            scope.launch {
+                                EhDB.watchItemDao().setEnabled(w.id, on)
+                                reload()
+                            }
+                        },
+                    )
+                    IconButton(onClick = {
+                        scope.launch {
+                            EhDB.watchItemDao().deleteById(w.id)
+                            reload()
+                        }
+                    }) {
+                        Icon(Icons.Default.Delete, contentDescription = "删除")
+                    }
+                }
+                HorizontalDivider()
+            }
+            if (shown.isEmpty()) {
+                item { Text("没有关注项", modifier = Modifier.padding(24.dp)) }
+            }
+        }
+    }
+
+    if (showAdd) {
+        val text = rememberTextFieldState()
+        var kind by remember { mutableStateOf("artist") }
+        AlertDialog(
+            onDismissRequest = { showAdd = false },
+            title = { Text("新增关注") },
+            text = {
+                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                    Row(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                        KINDS.forEach { (k, label) ->
+                            AssistChip(
+                                onClick = { kind = k },
+                                label = { Text(if (kind == k) "✓$label" else label) },
+                            )
+                        }
+                    }
+                    OutlinedTextField(
+                        state = text,
+                        label = { Text(if (kind == "title") "标题关键词" else "名称（如 shouji ayumu）") },
+                        lineLimits = TextFieldLineLimits.SingleLine,
+                    )
+                }
+            },
+            confirmButton = {
+                TextButton(onClick = {
+                    val v = text.text.toString().trim()
+                    if (v.isNotEmpty()) {
+                        scope.launch {
+                            EhDB.watchItemDao().insert(
+                                WatchItem(kind = kind, content = v, createdAt = System.currentTimeMillis()),
+                            )
+                            reload()
+                            showAdd = false
+                        }
+                    }
+                }) { Text("添加") }
+            },
+            dismissButton = { TextButton(onClick = { showAdd = false }) { Text("取消") } },
+        )
+    }
+}
+

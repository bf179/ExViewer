+/**
+ * 关注页：展示已启用的关注项（艺术家 / 社团 / 标签 / 标题 / 其他），
+ * 点一条即按对应语法打开站点搜索。管理入口在右上角。
+ */
+@Destination<RootGraph>
+@Composable
+fun AnimatedVisibilityScope.WatchFeedScreen(navigator: DestinationsNavigator) = Screen(navigator) {
+    val scrollBehavior = TopAppBarDefaults.pinnedScrollBehavior()
+    val items = remember { mutableStateListOf<WatchItem>() }
+
+    LaunchedEffect(Unit) {
+        items.clear()
+        items.addAll(EhDB.watchItemDao().listEnabled())
+    }
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text("关注 · ${items.size}") },
+                navigationIcon = { NavigationIcon() },
+                actions = {
+                    IconButton(onClick = { navigator.navigate(WatchListScreenDestination()) }) {
+                        Icon(Icons.Default.Settings, contentDescription = "关注列表管理")
+                    }
+                },
+                scrollBehavior = scrollBehavior,
+            )
+        },
+    ) { padding ->
+        LazyColumn(
+            modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+            contentPadding = padding,
+        ) {
+            items.groupBy { it.kind }.forEach { (kind, list) ->
+                item(key = "h_$kind") {
+                    Text(
+                        text = kindLabel(kind) + "（${list.size}）",
+                        style = MaterialTheme.typography.labelMedium,
+                        modifier = Modifier.padding(horizontal = 16.dp, vertical = 6.dp),
+                    )
+                }
+                items(list, key = { "${it.kind}_${it.content}" }) { w ->
+                    Column(
+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .clickable {
+                                val builder = ListUrlBuilder().apply {
+                                    keyword = watchKeyword(w)
+                                }
+                                navigator.navigate(builder.asDst())
+                            }
+                            .padding(horizontal = 16.dp, vertical = 10.dp),
+                        verticalArrangement = Arrangement.spacedBy(2.dp),
+                    ) {
+                        Text(w.content, maxLines = 1, overflow = TextOverflow.Ellipsis)
+                        Text(
+                            text = watchKeyword(w) + (w.note?.let { " · $it" } ?: ""),
+                            style = MaterialTheme.typography.bodySmall,
+                            maxLines = 1,
+                            overflow = TextOverflow.Ellipsis,
+                        )
+                    }
+                    HorizontalDivider()
+                }
+            }
+            if (items.isEmpty()) {
+                item {
+                    Text(
+                        text = "还没有关注项。可在搜索结果页或标签长按菜单里添加。",
+                        modifier = Modifier.padding(24.dp),
+                        style = MaterialTheme.typography.bodyMedium,
+                    )
+                }
+            }
+            item(key = "tip") {
+                Text(
+                    text = "提示：把常看的作者/社团加进来，比塞满快速搜索更清爽。",
+                    modifier = Modifier.padding(16.dp),
+                    style = MaterialTheme.typography.labelSmall,
+                )
+            }
+        }
+    }
+}
+
+internal fun kindLabel(kind: String): String = when (kind) {
+    "artist" -> "艺术家"
+    "circle" -> "社团"
+    "tag" -> "标签"
+    "title" -> "标题"
+    else -> "其他"
+}
+
+internal fun watchKeyword(item: WatchItem): String = when (item.kind) {
+    "artist" -> "artist:${item.content}"
+    "circle" -> "group:${item.content}"
+    "title" -> "\"${item.content}\""
+    else -> item.content
+}
+

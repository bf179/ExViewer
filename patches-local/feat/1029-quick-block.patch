+package com.hippo.ehviewer.ui.settings
+
+import androidx.compose.animation.AnimatedVisibilityScope
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.text.input.TextFieldLineLimits
+import androidx.compose.foundation.text.input.rememberTextFieldState
+import androidx.compose.material3.AssistChip
+import androidx.compose.material3.Button
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Scaffold
+import androidx.compose.material3.Text
+import androidx.compose.material3.TopAppBar
+import androidx.compose.material3.TopAppBarDefaults
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.input.nestedscroll.nestedScroll
+import androidx.compose.ui.unit.dp
+import com.ehviewer.core.database.model.Filter
+import com.ehviewer.core.database.model.FilterMode
+import com.hippo.ehviewer.EhDB
+import com.hippo.ehviewer.ui.Screen
+import com.hippo.ehviewer.ui.main.NavigationIcon
+import com.ramcosta.composedestinations.annotation.Destination
+import com.ramcosta.composedestinations.annotation.RootGraph
+import com.ramcosta.composedestinations.navigation.DestinationsNavigator
+import kotlinx.coroutines.launch
+
+/**
+ * 快捷添加屏蔽项（智能识别类型，可手动改）。
+ *
+ * 识别顺序（EXL-SYSTEM.md §3.2）：
+ *   uploader:xxx           → 上传者
+ *   单个 namespace:tag      → 标签
+ *   多个 namespace:tag 组合 → 标签组（复合标签）
+ *   其他（含空格/标点）      → 标题
+ */
+@Destination<RootGraph>
+@Composable
+fun AnimatedVisibilityScope.QuickBlockScreen(navigator: DestinationsNavigator) = Screen(navigator) {
+    val scrollBehavior = TopAppBarDefaults.pinnedScrollBehavior()
+    val scope = rememberCoroutineScope()
+    val input = rememberTextFieldState()
+    var manual by remember { mutableStateOf<FilterMode?>(null) }
+    var savedHint by remember { mutableStateOf("") }
+
+    val text = input.text.toString().trim()
+    val detected = manual ?: detectFilterMode(text)
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text("快捷添加屏蔽项") },
+                navigationIcon = { NavigationIcon() },
+                scrollBehavior = scrollBehavior,
+            )
+        },
+    ) { padding ->
+        Column(
+            modifier = Modifier.padding(padding).padding(16.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+            androidx.compose.material3.OutlinedTextField(
+                state = input,
+                label = { Text("输入要屏蔽的内容（标签 / 作者 / 标题 / 组合标签）") },
+                lineLimits = TextFieldLineLimits.MultiLine(minHeightInLines = 2, maxHeightInLines = 4),
+                modifier = Modifier.fillMaxWidth(),
+            )
+
+            Text(
+                text = "识别为：${modeLabel(detected)}（可点下面切换）",
+                style = MaterialTheme.typography.bodyMedium,
+            )
+
+            Row(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                listOf(
+                    FilterMode.TITLE,
+                    FilterMode.UPLOADER,
+                    FilterMode.TAG,
+                    FilterMode.TAG_GROUP,
+                ).forEach { mode ->
+                    AssistChip(
+                        onClick = { manual = mode },
+                        label = { Text(if (mode == detected) "✓${modeLabel(mode)}" else modeLabel(mode)) },
+                    )
+                }
+            }
+
+            Text(
+                text = rulePreview(detected, text),
+                style = MaterialTheme.typography.bodySmall,
+            )
+
+            Button(
+                onClick = {
+                    if (text.isNotEmpty()) {
+                        scope.launch {
+                            val ok = EhDB.addFilter(Filter(mode = detected, text = text))
+                            savedHint = if (ok) "已添加：${modeLabel(detected)} · $text" else "已存在，未重复添加"
+                        }
+                    }
+                },
+                modifier = Modifier.fillMaxWidth(),
+            ) { Text("添加屏蔽规则") }
+
+            if (savedHint.isNotEmpty()) {
+                Text(savedHint, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.primary)
+            }
+
+            Text(
+                text = "提示：标签组支持 \"tag1 tag2\" 空格组合（同时命中才屏蔽）；" +
+                    "标题支持引号短语；- 前缀表示白名单（不屏蔽）。",
+                style = MaterialTheme.typography.labelSmall,
+            )
+        }
+    }
+}
+
+private fun modeLabel(mode: FilterMode): String = when (mode) {
+    FilterMode.TITLE -> "标题"
+    FilterMode.UPLOADER -> "上传者"
+    FilterMode.TAG -> "标签"
+    FilterMode.TAG_GROUP -> "标签组"
+    else -> mode.name
+}
+
+internal fun detectFilterMode(text: String): FilterMode {
+    val t = text.trim()
+    if (t.isEmpty()) return FilterMode.TITLE
+    if (t.startsWith("uploader:", true)) return FilterMode.UPLOADER
+    val tokens = t.split(" ", "\n").filter { it.isNotBlank() }
+    val tagLike = tokens.count { it.contains(":") && !it.startsWith("-") }
+    return when {
+        tagLike >= 2 -> FilterMode.TAG_GROUP
+        tagLike == 1 && tokens.size == 1 -> FilterMode.TAG
+        tagLike >= 1 -> FilterMode.TAG_GROUP
+        else -> FilterMode.TITLE
+    }
+}
+
+private fun rulePreview(mode: FilterMode, text: String): String = when (mode) {
+    FilterMode.TITLE -> "屏蔽标题包含「${text}」的画廊"
+    FilterMode.UPLOADER -> "屏蔽上传者为「${text.removePrefix("uploader:")}」的画廊"
+    FilterMode.TAG -> "屏蔽含标签「${text}」的画廊"
+    FilterMode.TAG_GROUP -> "屏蔽同时命中「${text}」全部条件的画廊"
+    else -> ""
+}
+

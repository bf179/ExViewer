     }
+
+    // ===== 关注页：服务端按关注项抓取的画廊 =====
+
+    @Serializable
+    data class WatchGalleryItem(
+        val gid: Long = 0,
+        val token: String = "",
+        val title: String? = null,
+        val title_jpn: String? = null,
+        val thumb: String? = null,
+        val category: String? = null,
+        val uploader: String? = null,
+        val posted: Long = 0,
+        val filecount: Int = 0,
+        val filesize: Long = 0,
+        val rating: Float = 0f,
+        val expunged: Int = 0,
+        val fav_status: Int = 0,
+    )
+
+    suspend fun watchGalleries(page: Int, pageSize: Int = 30, order: String = "new"): Pair<List<WatchGalleryItem>, Int> {
+        val obj = call("watch_galleries", buildJsonObject {
+            put("page", page)
+            put("page_size", pageSize)
+            put("order", order)
+        })?.data() ?: return emptyList<WatchGalleryItem>() to 0
+        val items = runCatching {
+            obj["items"]!!.jsonArray.map { json.decodeFromJsonElement(WatchGalleryItem.serializer(), it) }
+        }.getOrDefault(emptyList())
+        val total = runCatching { obj["total"]!!.jsonPrimitive.intOrNull ?: items.size }.getOrDefault(items.size)
+        return items to total
+    }
+
+    /** 把本地关注项整份推到服务端（kind, content, enabled）。 */
+    suspend fun watchSync(items: List<Triple<String, String, Boolean>>): Boolean {
+        val arr = buildJsonArray {
+            items.forEach { (kind, content, enabled) ->
+                add(buildJsonObject {
+                    put("kind", kind)
+                    put("content", content)
+                    put("enabled", if (enabled) 1 else 0)
+                })
+            }
+        }
+        val obj = call("watch_sync", buildJsonObject { put("items", arr) }) ?: return false
+        return obj["data"] != null
+    }
 }
 

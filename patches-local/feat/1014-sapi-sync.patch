diff --git a/app/src/main/kotlin/com/hippo/ehviewer/client/ExlApi.kt b/app/src/main/kotlin/com/hippo/ehviewer/client/ExlApi.kt
new file mode 100644
--- /dev/null
+++ b/app/src/main/kotlin/com/hippo/ehviewer/client/ExlApi.kt
@@ -0,0 +1,133 @@
+package com.hippo.ehviewer.client
+
+import android.os.Handler
+import android.os.Looper
+import android.widget.Toast
+import com.hippo.ehviewer.EhApplication
+import com.hippo.ehviewer.Settings
+import io.ktor.client.call.body
+import io.ktor.client.request.post
+import io.ktor.client.request.setBody
+import io.ktor.http.ContentType
+import io.ktor.http.content.TextContent
+import kotlinx.coroutines.delay
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import splitties.init.appCtx
+
+/**
+ * 自有服务端联动（旧版 8f750fe 的 SAPI / PAPI 特性移植）。
+ *
+ * - SAPI（`sapi_url`，如 `https://exl.loliwant.cc`）：收藏 / 取消收藏后同步收藏状态
+ *   `POST /exl`，body `{user,gid,token,favoriteslot,op}`；`/uc` 上传 cookie 身份。
+ * - PAPI（`papi_url`，如 `https://exl.loliwant.cc/add_item`）：把标签加入优先队列。
+ */
+@Serializable
+data class ExlApiRequest(
+    val user: String,
+    val gid: Long,
+    val token: String,
+    var favoriteslot: Int,
+    val op: String,
+)
+
+@Serializable
+data class PqApiRequest(
+    val user: String,
+    val itype: String,
+    val icontent: String,
+)
+
+/** /uc：gid = ipb_member_id，token = "ipb_pass_hash_igneous" */
+@Serializable
+data class UcApiRequest(
+    val gid: String,
+    val token: String,
+)
+
+private const val DEFAULT_USER = "loliwant"
+private var currentToast: Toast? = null
+
+fun showToastOnMainThread(message: String) {
+    Handler(Looper.getMainLooper()).post {
+        currentToast?.cancel()
+        currentToast = Toast.makeText(appCtx, message, Toast.LENGTH_SHORT).apply { show() }
+    }
+}
+
+/** 通用 JSON POST（带 3 次重试，间隔 5s），返回是否成功 */
+private suspend fun postJson(url: String, payload: String, showSuccessToast: Boolean): Boolean {
+    repeat(3) { attempt ->
+        try {
+            val response = EhApplication.ktorClient.post(url) {
+                setBody(TextContent(payload, ContentType.Application.Json))
+            }
+            val bodyText: String = response.body()
+            val json = runCatching { Json.decodeFromString<Map<String, String>>(bodyText) }.getOrNull()
+            when (response.status.value) {
+                in 200..299 -> {
+                    if (showSuccessToast) {
+                        showToastOnMainThread(json?.get("message") ?: "已同步到服务端")
+                    }
+                    return true
+                }
+
+                400 -> {
+                    showToastOnMainThread("请求错误: ${json?.get("error") ?: bodyText.take(80)}")
+                    return false
+                }
+
+                in 500..599 -> {
+                    showToastOnMainThread("服务端错误: ${json?.get("error") ?: bodyText.take(80)}")
+                    return false
+                }
+
+                else -> {
+                    if (attempt == 2) {
+                        showToastOnMainThread("同步失败: ${response.status}")
+                        return false
+                    }
+                    delay(5000)
+                }
+            }
+        } catch (e: Exception) {
+            if (attempt == 2) {
+                showToastOnMainThread("同步异常: ${e.message}")
+                return false
+            }
+            delay(5000)
+        }
+    }
+    return false
+}
+
+suspend fun sendExlApiRequest(req: ExlApiRequest, sapi: String, showSuccessToast: Boolean = true) {
+    postJson(sapi, Json.encodeToString(req), showSuccessToast)
+}
+
+suspend fun sendPqApiRequest(req: PqApiRequest, papi: String) {
+    postJson(papi, Json.encodeToString(req), true)
+}
+
+suspend fun sendUcApiRequest(req: UcApiRequest, sapi: String) {
+    val url = sapi.trimEnd('/') + "/uc"
+    postJson(url, Json.encodeToString(req), true)
+}
+
+/** 收藏状态同步入口：未启用或未配置地址时直接返回 */
+suspend fun syncFavoriteToServer(
+    gid: Long,
+    token: String,
+    favoriteSlot: Int,
+    op: String,
+    showSuccessToast: Boolean = false,
+) {
+    if (!Settings.syncFav.value) return
+    val sapi = Settings.sapiUrl.value?.takeIf { it.isNotBlank() } ?: return
+    sendExlApiRequest(
+        ExlApiRequest(user = DEFAULT_USER, gid = gid, token = token, favoriteslot = favoriteSlot, op = op),
+        sapi,
+        showSuccessToast,
+    )
+}

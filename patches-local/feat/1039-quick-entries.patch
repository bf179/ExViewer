+++ b/app/src/main/kotlin/com/hippo/ehviewer/client/WatchClassify.kt
@@ -0,0 +1,47 @@
+package com.hippo.ehviewer.client
+
+import com.ehviewer.core.database.model.FilterMode
+
+/**
+ * 关注项 / 屏蔽项的「智能识别」判定——与旧版 addKeyword、FilterAlt 的判定保持一致的语义，
+ * 入口在页面里（搜索结果页动作栏 / 详情页），不在设置页。
+ */
+
+/** uploader:xxx / artist:xxx / group:xxx / tag:xxx → 对应 kind；其余（含空格多词）视为标题 */
+fun watchKindOf(raw: String): String {
+    val t = raw.trim()
+    return when {
+        t.startsWith("uploader:", true) -> "uploader"
+        t.startsWith("artist:", true) -> "artist"
+        t.startsWith("group:", true) -> "circle"
+        t.startsWith("tag:", true) -> "tag"
+        else -> "title"
+    }
+}
+
+/** 去掉 namespace 前缀；多标签用空格分隔时视为「标签组」（或逻辑，用 | 连接） */
+fun watchContentOf(raw: String): String {
+    val t = raw.trim()
+    val body = if (t.contains(":")) t.substringAfter(':').trim() else t
+    val tokens = body.split(" ", "\n").map { it.trim() }.filter { it.isNotEmpty() }
+    return if (tokens.size > 1) tokens.joinToString(" | ") else body
+}
+
+fun watchKindLabel(kind: String): String = when (kind) {
+    "artist" -> "艺术家"
+    "circle" -> "社团"
+    "tag" -> "标签"
+    "uploader" -> "上传者"
+    "group" -> "标签组"
+    else -> "标题"
+}
+
+fun filterModeLabel(mode: FilterMode): String = when (mode) {
+    FilterMode.TITLE -> "标题"
+    FilterMode.UPLOADER -> "上传者"
+    FilterMode.TAG -> "标签"
+    FilterMode.TAG_GROUP -> "标签组"
+    FilterMode.TAG_NAMESPACE -> "命名空间"
+    FilterMode.COMMENT -> "评论"
+    FilterMode.COMMENTER -> "评论者"
+}

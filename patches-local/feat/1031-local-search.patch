@@ -0,0 +1,89 @@
+package com.hippo.ehviewer.client
+
+/**
+ * 本地搜索表达式（与站点语法同构的简化实现）：
+ *
+ *   tag              包含子串
+ *   -tag             排除
+ *   "多词短语"        整体匹配
+ *   ~foo             模糊（忽略大小写与空格）
+ *   namespace:value  精确前缀（如 artist:xxx）
+ *   空格             AND
+ *   |                OR（优先级最低）
+ *
+ * 只做「元数据字段的包含/排除」，不联网。
+ */
+object LocalQuery {
+    data class Token(val text: String, val negate: Boolean, val fuzzy: Boolean)
+
+    private fun tokenize(query: String): List<List<Token>> {
+        // 先按 | 切成 OR 组，再按空格切 AND
+        return query.split("|").map { group ->
+            val tokens = mutableListOf<Token>()
+            var i = 0
+            val s = group.trim()
+            val sb = StringBuilder()
+            var negate = false
+            var fuzzy = false
+            var inQuote = false
+            fun flush() {
+                val t = sb.toString().trim()
+                if (t.isNotEmpty()) tokens.add(Token(t, negate, fuzzy))
+                sb.clear()
+                negate = false
+                fuzzy = false
+            }
+            while (i < s.length) {
+                val c = s[i]
+                when {
+                    c == '"' -> {
+                        inQuote = !inQuote
+                        i++
+                    }
+                    !inQuote && c.isWhitespace() -> {
+                        flush()
+                        i++
+                    }
+                    !inQuote && c == '-' && sb.isEmpty() -> {
+                        negate = true
+                        i++
+                    }
+                    !inQuote && c == '~' && sb.isEmpty() -> {
+                        fuzzy = true
+                        i++
+                    }
+                    else -> {
+                        sb.append(c)
+                        i++
+                    }
+                }
+            }
+            flush()
+            tokens
+        }.filter { it.isNotEmpty() }
+    }
+
+    private fun Token.hit(haystacks: List<String?>): Boolean {
+        val needles = haystacks.mapNotNull { it?.lowercase() }
+        return if (fuzzy) {
+            val n = text.lowercase().replace(" ", "")
+            needles.any { it.replace(" ", "").contains(n) }
+        } else {
+            val n = text.lowercase()
+            needles.any { it.contains(n) }
+        }
+    }
+
+    /** 空查询恒为 true。 */
+    fun matches(query: String, vararg fields: String?): Boolean {
+        val q = query.trim()
+        if (q.isEmpty()) return true
+        val groups = tokenize(q)
+        if (groups.isEmpty()) return true
+        val hay = fields.toList()
+        return groups.any { andGroup ->
+            andGroup.all { tok -> if (tok.negate) !tok.hit(hay) else tok.hit(hay) }
+        }
+    }
+}
+

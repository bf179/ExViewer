+package com.hippo.ehviewer.client
+
+import com.ehviewer.core.database.model.GalleryOrigin
+import com.hippo.ehviewer.EhDB
+
+/**
+ * 来源索引同步：把服务端 /api origins 拉下来，落到本地 gallery_origin 快捷副本。
+ *
+ * kinds: pq（下载优先） / feed（优先订阅） / expunged（已下架）
+ * 列表过滤（ExlPrefs.hideXxxInList）只读本地这张表，所以必须定期同步一次。
+ */
+object OriginSyncer {
+    suspend fun sync(): Int {
+        val map = ExlClient.origins()
+        if (map.isEmpty()) return 0
+        val merged = LinkedHashMap<Int, MutableSet<String>>()
+        map.forEach { (kind, gids) ->
+            gids.forEach { gid -> merged.getOrPut(gid) { linkedSetOf() }.add(kind) }
+        }
+        if (merged.isEmpty()) return 0
+        val rows = merged.map { (gid, kinds) -> GalleryOrigin(gid, kinds.joinToString(",")) }
+        val dao = EhDB.galleryOriginDao()
+        dao.clear()
+        // 分批写，避免单条 SQL 超过 SQLite 参数上限
+        rows.chunked(500).forEach { dao.insertAll(it) }
+        return rows.size
+    }
+
+    suspend fun count(): Int = EhDB.galleryOriginDao().count()
+
+    suspend fun kindsOf(gid: Int): String = EhDB.galleryOriginDao().kindsOf(gid).orEmpty()
+}
+

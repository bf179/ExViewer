--- /dev/null
+++ b/app/src/main/kotlin/com/hippo/ehviewer/client/SeriesKeyword.kt
@@ -0,0 +1,13 @@
+package com.hippo.ehviewer.client
+
+/** 从画廊标题里提取「系列名」：优先取【】或 [] 内的内容，否则回退整条标题。 */
+object SeriesKeyword {
+    private val BRACKET = Regex("[【\\[]([^】\\]]{2,40})[】\\]]")
+
+    fun extract(title: String?): String {
+        val t = title?.trim().orEmpty()
+        if (t.isEmpty()) return ""
+        val m = BRACKET.find(t)
+        return m?.groupValues?.get(1)?.trim()?.takeIf { it.isNotEmpty() } ?: t
+    }
+}

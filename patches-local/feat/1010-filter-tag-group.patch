-    suspend fun needTags() = filters.await().any { it.enable && (it.mode == FilterMode.TAG || it.mode == FilterMode.TAG_NAMESPACE) }
+    suspend fun needTags() = filters.await().any {
+        it.enable && (it.mode == FilterMode.TAG || it.mode == FilterMode.TAG_NAMESPACE || it.mode == FilterMode.TAG_GROUP)
+    }
     suspend fun filterTitle(info: GalleryInfo) = anyActive(FilterMode.TITLE) { info.title.orEmpty().contains(it.text, true) }
     suspend fun filterUploader(info: GalleryInfo) = anyActive(FilterMode.UPLOADER) { it.text == info.uploader }
     suspend fun filterTag(info: GalleryInfo) = info.simpleTags?.any { tag -> anyActive(FilterMode.TAG) { matchTag(tag, it.text.lowercase()) } } == true
     suspend fun filterTagNamespace(info: GalleryInfo) = info.simpleTags?.any { tag -> anyActive(FilterMode.TAG_NAMESPACE) { matchTagNamespace(tag, it.text.lowercase()) } } == true
     suspend fun filterCommenter(commenter: String) = anyActive(FilterMode.COMMENTER) { it.text == commenter }
     suspend fun filterComment(comment: String) = anyActive(FilterMode.COMMENT) { regex(it).containsMatchIn(comment) }
+
+    /**
+     * 复合标签过滤（旧版 `FILTER.MODE=6` 语义，兼容 8f750fe 数据库导入）。
+     *
+     * 规则文本按逗号分段，支持四种写法：
+     * - `uploader:xxx`  上传者，全部匹配
+     * - `"标题片段"`     标题包含，全部匹配
+     * - `-tag`          白名单标签，任一命中则不屏蔽
+     * - 其它            黑名单标签，全部匹配
+     *
+     * 已收藏画廊不参与过滤（与旧版一致）。
+     */
+    suspend fun filterTagGroup(info: GalleryInfo): Boolean {
+        if (info.favoriteSlot != GalleryInfo.NOT_FAVORITED) return false
+        return anyActive(FilterMode.TAG_GROUP) { composite ->
+            val parts = composite.text.split(',').map { it.trim() }.filter { it.isNotEmpty() }
+            val uploaderFilters = mutableListOf<String>()
+            val titleFilters = mutableListOf<String>()
+            val blacklistTagFilters = mutableListOf<String>()
+            val whitelistTagFilters = mutableListOf<String>()
+            parts.forEach { part ->
+                when {
+                    part.startsWith("uploader:") -> uploaderFilters.add(part.removePrefix("uploader:").trim())
+                    part.startsWith("\"") && part.endsWith("\"") && part.length > 1 ->
+                        titleFilters.add(part.substring(1, part.length - 1).trim())
+                    part.startsWith("-") -> whitelistTagFilters.add(part.substring(1).lowercase())
+                    else -> blacklistTagFilters.add(part.lowercase())
+                }
+            }
+            val tags = info.simpleTags.orEmpty().map { it.lowercase() }
+            if (whitelistTagFilters.isNotEmpty() && tags.any { tag -> whitelistTagFilters.any { matchTag(tag, it) } }) {
+                return@anyActive false
+            }
+            val uploaderMatched = uploaderFilters.isEmpty() || uploaderFilters.all { it.equals(info.uploader, true) }
+            val titleMatched = titleFilters.isEmpty() || titleFilters.all { info.title.orEmpty().contains(it, true) }
+            val blacklistMatched = blacklistTagFilters.isEmpty() ||
+                blacklistTagFilters.all { required -> tags.any { tag -> matchTag(tag, required) } }
+            uploaderMatched && titleMatched && blacklistMatched
+        }
+    }
 }

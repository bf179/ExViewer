diff --git a/app/src/main/kotlin/com/hippo/ehviewer/client/TaskSource.kt b/app/src/main/kotlin/com/hippo/ehviewer/client/TaskSource.kt
new file mode 100644
--- /dev/null
+++ b/app/src/main/kotlin/com/hippo/ehviewer/client/TaskSource.kt
@@ -0,0 +1,60 @@
+package com.hippo.ehviewer.client
+
+import com.hippo.ehviewer.ExlPrefs
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.builtins.MapSerializer
+import kotlinx.serialization.builtins.serializer
+import kotlinx.serialization.json.Json
+
+/**
+ * 批量任务来源快照：记录任务发起时所在的页面（搜索词 / 模式 / 分类），
+ * 让「任务中心」能显示来源并一键回到那个列表页。
+ *
+ * 刻意不写 Room：batch_fav_tasks 表结构保持不动，避免 DB 版本迁移；
+ * 快照按任务 id 存在 DataStore 的一个 JSON map 里，最多保留 50 条。
+ */
+@Serializable
+data class TaskSource(
+    val label: String = "",
+    val mode: Int = 0,
+    val category: Int = 0,
+    val keyword: String? = null,
+    val advanceSearch: Int = 0,
+    val minRating: Int = 0,
+)
+
+object TaskSources {
+    private val json = Json {
+        ignoreUnknownKeys = true
+        encodeDefaults = true
+    }
+
+    private val mapSerializer = MapSerializer(String.serializer(), TaskSource.serializer())
+
+    private fun parse(): MutableMap<String, TaskSource> {
+        val raw = ExlPrefs.taskSources.value
+        if (raw.isBlank()) return mutableMapOf()
+        return runCatching { json.decodeFromString(mapSerializer, raw).toMutableMap() }
+            .getOrElse { mutableMapOf() }
+    }
+
+    private suspend fun write(map: Map<String, TaskSource>) {
+        ExlPrefs.taskSources.value = json.encodeToString(mapSerializer, map)
+    }
+
+    suspend fun save(taskId: Long, source: TaskSource) {
+        val map = parse()
+        map[taskId.toString()] = source
+        if (map.size > 50) {
+            map.keys.take(map.size - 50).forEach { map.remove(it) }
+        }
+        write(map)
+    }
+
+    fun load(taskId: Long): TaskSource? = parse()[taskId.toString()]
+
+    suspend fun forget(taskId: Long) {
+        val map = parse()
+        if (map.remove(taskId.toString()) != null) write(map)
+    }
+}
diff --git a/app/src/main/kotlin/com/hippo/ehviewer/client/ExlListCache.kt b/app/src/main/kotlin/com/hippo/ehviewer/client/ExlListCache.kt

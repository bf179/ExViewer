--- /dev/null
+++ b/app/src/main/kotlin/com/hippo/ehviewer/client/ExlListCache.kt
@@ -0,0 +1,43 @@
+package com.hippo.ehviewer.client
+
+/**
+ * 远端列表页的短期缓存：同一 (action, 分页参数) 在 TTL 内直接返回上次结果。
+ *
+ * 解决「进画廊再返回 → 列表白屏重载」：返回时首帧就能拿到数据渲染，
+ * 后台再刷新（调用方传 force=true）。
+ *
+ * 只在内存里，进程结束即失效；不做磁盘持久化，避免和服务端数据不一致。
+ */
+object ExlListCache {
+    private const val DEFAULT_TTL_MS = 10 * 60 * 1000L
+
+    private data class Entry(val at: Long, val payload: Any)
+
+    private val map = LinkedHashMap<String, Entry>(32, 0.75f, true)
+
+    @Synchronized
+    fun put(key: String, payload: Any) {
+        map[key] = Entry(System.currentTimeMillis(), payload)
+        if (map.size > 60) {
+            val it = map.entries.iterator()
+            if (it.hasNext()) {
+                it.next()
+                it.remove()
+            }
+        }
+    }
+
+    @Suppress("UNCHECKED_CAST")
+    @Synchronized
+    fun <T> get(key: String, ttlMs: Long = DEFAULT_TTL_MS): T? {
+        val e = map[key] ?: return null
+        if (System.currentTimeMillis() - e.at > ttlMs) {
+            map.remove(key)
+            return null
+        }
+        return e.payload as? T
+    }
+
+    @Synchronized
+    fun clear() = map.clear()
+}

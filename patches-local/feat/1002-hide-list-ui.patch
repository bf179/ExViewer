+// 与 EhHideList 的 hideType 一一对应：下标 + 1
+private val HIDE_TYPE_NAMES = arrayOf("标题", "上传者", "标签")
+
+private fun typeName(hideType: Int): String = when (hideType) {
+    EhHideList.TYPE_TITLE -> "标题"
+    EhHideList.TYPE_UPLOADER -> "上传者"
+    EhHideList.TYPE_TAG -> "标签"
+    else -> "未知"
+}
+
+/**
+ * 隐藏列表管理：标题/上传者/标签三类条目增删。
+ * 命中任一规则即从列表剔除（OR 语义），规则见 [EhHideList]。
+ */
+@Destination<RootGraph>
+@Composable
+fun AnimatedVisibilityScope.HideListScreen(navigator: DestinationsNavigator) = Screen(navigator) {
+    val scrollBehavior = TopAppBarDefaults.pinnedScrollBehavior()
+    val entries = remember { mutableStateListOf<QuickSearch>() }
+    val animateItems by Settings.animateItems.collectAsState()
+    val textIsEmpty = stringResource(R.string.text_is_empty)
+
+    LaunchedEffect(Unit) {
+        entries.clear()
+        entries.addAll(EhHideList.entries())
+    }
+
+    fun addEntry() {
+        launch {
+            dialog { cont ->
+                var selectedIndex by remember { mutableIntStateOf(0) }
+                val state = rememberTextFieldState()
+                var error by remember { mutableStateOf<String?>(null) }
+                fun invalidateAndSave() {
+                    if (state.text.isBlank()) {
+                        error = textIsEmpty
+                        return
+                    }
+                    val hideType = selectedIndex + 1
+                    val text = state.text.toString().trim()
+                    launch {
+                        if (EhHideList.entries().any { it.hideType == hideType && it.name == text }) {
+                            error = "已存在相同条目"
+                            return@launch
+                        }
+                        error = null
+                        val entry = QuickSearch(name = text, hideType = hideType)
+                        EhHideList.add(entry)
+                        entries.add(entry)
+                        cont.resume(Unit)
+                    }
+                }
+                AlertDialog(
+                    onDismissRequest = { cont.cancel() },
+                    confirmButton = {
+                        TextButton(onClick = ::invalidateAndSave, shapes = ButtonDefaults.shapes()) {
+                            Text(text = "添加")
+                        }
+                    },
+                    dismissButton = {
+                        TextButton(onClick = { cont.cancel() }, shapes = ButtonDefaults.shapes()) {
+                            Text(text = stringResource(android.R.string.cancel))
+                        }
+                    },
+                    title = { Text(text = "添加隐藏条目") },
+                    text = {
+                        Column(verticalArrangement = Arrangement.spacedBy(16.dp)) {
+                            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                                HIDE_TYPE_NAMES.forEachIndexed { index, name ->
+                                    FilterChip(
+                                        selected = selectedIndex == index,
+                                        onClick = { selectedIndex = index },
+                                        label = { Text(text = name) },
+                                    )
+                                }
+                            }
+                            val isError = error != null
+                            OutlinedTextField(
+                                state = state,
+                                label = { Text(text = "内容") },
+                                supportingText = { error?.let { Text(text = it) } },
+                                trailingIcon = {
+                                    if (isError) {
+                                        Icon(imageVector = Icons.Filled.Info, contentDescription = null)
+                                    }
+                                },
+                                isError = isError,
+                                lineLimits = TextFieldLineLimits.SingleLine,
+                                keyboardOptions = KeyboardOptions(imeAction = ImeAction.Done),
+                            )
+                        }
+                    },
+                )
+            }
+        }
+    }
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text(text = stringResource(R.string.hide_list)) },
+                navigationIcon = { NavigationIcon() },
+                actions = {
+                    IconButton(
+                        onClick = {
+                            launch {
+                                awaitConfirmationOrCancel(showCancelButton = false) {
+                                    Text(
+                                        text = "标题：画廊标题包含该文本时隐藏；\n" +
+                                            "上传者：画廊上传者等于该文本时隐藏；\n" +
+                                            "标签：画廊标签命中该标签时隐藏。\n\n" +
+                                            "任一规则命中即隐藏（OR 语义）。",
+                                    )
+                                }
+                            }
+                        },
+                        shapes = IconButtonDefaults.shapes(),
+                    ) {
+                        Icon(imageVector = Icons.AutoMirrored.Default.Help, contentDescription = null)
+                    }
+                },
+                scrollBehavior = scrollBehavior,
+            )
+        },
+        floatingActionButton = {
+            FloatingActionButton(onClick = ::addEntry) {
+                Icon(imageVector = Icons.Default.Add, contentDescription = null)
+            }
+        },
+    ) { paddingValues ->
+        LazyColumn(
+            modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+            contentPadding = paddingValues,
+        ) {
+            item(key = "enabled") {
+                SwitchPreference(
+                    title = stringResource(R.string.hide_list_enabled),
+                    summary = stringResource(R.string.hide_list_enabled_summary),
+                    state = Settings.hideListEnabled.asMutableState(),
+                )
+            }
+            (1..3).forEach { hideType ->
+                val group = entries.filter { it.hideType == hideType }
+                if (group.isNotEmpty()) {
+                    item(key = "header_$hideType") {
+                        Text(
+                            text = typeName(hideType),
+                            modifier = Modifier.padding(horizontal = 24.dp, vertical = 8.dp).thenIf(animateItems) { animateItem() },
+                            color = MaterialTheme.colorScheme.tertiary,
+                            style = MaterialTheme.typography.titleMedium,
+                        )
+                    }
+                    items(group, key = { requireNotNull(it.id) }) { entry ->
+                        Row(
+                            modifier = Modifier.fillMaxWidth().thenIf(animateItems) { animateItem() },
+                            verticalAlignment = Alignment.CenterVertically,
+                        ) {
+                            Text(
+                                text = entry.name,
+                                modifier = Modifier.weight(1f).padding(horizontal = 24.dp, vertical = 12.dp),
+                            )
+                            IconButton(
+                                onClick = {
+                                    launch {
+                                        awaitConfirmationOrCancel(confirmText = R.string.delete) {
+                                            Text(text = "删除隐藏条目「${entry.name}」？")
+                                        }
+                                        EhHideList.remove(entry)
+                                        entries.remove(entry)
+                                    }
+                                },
+                                shapes = IconButtonDefaults.shapes(),
+                            ) {
+                                Icon(imageVector = Icons.Default.Delete, contentDescription = null)
+                            }
+                        }
+                    }
+                }
+            }
+            if (entries.isEmpty()) {
+                item {
+                    Column(
+                        modifier = Modifier.fillMaxSize().padding(paddingValues),
+                        verticalArrangement = Arrangement.Center,
+                        horizontalAlignment = Alignment.CenterHorizontally,
+                    ) {
+                        Spacer(modifier = Modifier.size(80.dp))
+                        Icon(
+                            imageVector = Icons.Default.VisibilityOff,
+                            contentDescription = null,
+                            modifier = Modifier.padding(16.dp).size(120.dp),
+                            tint = MaterialTheme.colorScheme.primary,
+                        )
+                        Text(
+                            text = "暂无隐藏条目",
+                            style = MaterialTheme.typography.headlineMedium,
+                        )
+                    }
+                }
+            }
+        }
+    }
+}

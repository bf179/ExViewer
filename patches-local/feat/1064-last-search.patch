@@ -0,0 +1,69 @@
+package com.hippo.ehviewer.client
+
+import com.ehviewer.core.database.model.QuickSearch
+import com.hippo.ehviewer.ExlPrefs
+import com.hippo.ehviewer.client.data.ListUrlBuilder
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+
+/**
+ * 快速搜索状态保存 / 恢复（旧版 GalleryListScreen 的 Save / Restore 按钮）。
+ *
+ * 保存：当前搜索条件 + 当前首条画廊 gid（恢复后从该位置继续翻）。
+ * 恢复：重建 ListUrlBuilder 并刷新列表。
+ *
+ * 刻意不写 QUICK_SEARCH 表，避免污染用户的快捷搜索列表；改用 DataStore 单条 JSON。
+ */
+@Serializable
+private data class SearchSnapshot(
+    val mode: Int = 0,
+    val category: Int = 0,
+    val keyword: String? = null,
+    val advanceSearch: Int = 0,
+    val minRating: Int = 0,
+    val pageFrom: Int = 0,
+    val pageTo: Int = 0,
+    val anchorGid: Long = 0,
+)
+
+object LastSearch {
+    private const val NAME = "lastSearch"
+
+    private val json = Json {
+        ignoreUnknownKeys = true
+        encodeDefaults = true
+    }
+
+    suspend fun save(builder: ListUrlBuilder, anchorGid: Long) {
+        val snap = SearchSnapshot(
+            mode = builder.mode,
+            category = builder.category,
+            keyword = builder.keyword,
+            advanceSearch = builder.advanceSearch,
+            minRating = builder.minRating,
+            pageFrom = builder.pageFrom,
+            pageTo = builder.pageTo,
+            anchorGid = anchorGid,
+        )
+        ExlPrefs.lastSearchJson.value = json.encodeToString(SearchSnapshot.serializer(), snap)
+    }
+
+    suspend fun restore(): ListUrlBuilder? {
+        val raw = ExlPrefs.lastSearchJson.value
+        if (raw.isBlank()) return null
+        val snap = runCatching { json.decodeFromString(SearchSnapshot.serializer(), raw) }.getOrNull() ?: return null
+        val qs = QuickSearch(
+            name = "$NAME@${snap.anchorGid}",
+            mode = snap.mode,
+            category = snap.category,
+            keyword = snap.keyword,
+            advanceSearch = snap.advanceSearch,
+            minRating = snap.minRating,
+            pageFrom = snap.pageFrom,
+            pageTo = snap.pageTo,
+        )
+        return ListUrlBuilder(qs)
+    }
+
+    suspend fun hasSaved(): Boolean = ExlPrefs.lastSearchJson.value.isNotBlank()
+}

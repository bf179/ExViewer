+package com.ehviewer.core.database.model
+
+import androidx.room.ColumnInfo
+import androidx.room.Entity
+import androidx.room.PrimaryKey
+
+/**
+ * 画廊来源索引（本地快捷副本）：kinds 逗号分隔，如 "pq" / "feed" / "watch" / "expunged"。
+ * 供各列表的「隐藏来自 X 的画廊」判定，避免每次联网。
+ */
+@Entity(tableName = "gallery_origin")
+data class GalleryOrigin(
+    @PrimaryKey
+    @ColumnInfo(name = "gid")
+    val gid: Int,
+
+    @ColumnInfo(name = "kinds")
+    val kinds: String,
+)
+

+package com.ehviewer.core.database.model
+
+import androidx.room.ColumnInfo
+import androidx.room.Entity
+import androidx.room.PrimaryKey
+
+/**
+ * 版本链：一条记录代表「这个 gid 属于哪一支」（血脉根 gallery root）。
+ * 只信站点 gdata 的 current_gid，不猜、不做相似度推断。
+ *
+ * level: origin | l2_renamed | l3_expunged
+ */
+@Entity(tableName = "gallery_version")
+data class GalleryVersion(
+    @PrimaryKey
+    @ColumnInfo(name = "gid")
+    val gid: Int,
+
+    @ColumnInfo(name = "root_gid")
+    val rootGid: Int,
+
+    @ColumnInfo(name = "prev_gid")
+    val prevGid: Int? = null,
+
+    @ColumnInfo(name = "level")
+    val level: String = "origin",
+
+    @ColumnInfo(name = "fingerprint")
+    val fingerprint: String? = null,
+
+    @ColumnInfo(name = "detected_at")
+    val detectedAt: Long = 0L,
+)
+

@@ -0,0 +1,36 @@
+package com.ehviewer.core.database.dao
+
+import androidx.room.Dao
+import androidx.room.Insert
+import androidx.room.OnConflictStrategy
+import androidx.room.Query
+import com.ehviewer.core.database.model.GalleryVersion
+
+@Dao
+interface GalleryVersionDao {
+    @Query("SELECT * FROM gallery_version WHERE gid = :gid")
+    suspend fun get(gid: Int): GalleryVersion?
+
+    /** 谁是它的下一代 */
+    @Query("SELECT gid FROM gallery_version WHERE prev_gid = :gid LIMIT 1")
+    suspend fun successor(gid: Int): Int?
+
+    @Insert(onConflict = OnConflictStrategy.REPLACE)
+    suspend fun upsert(version: GalleryVersion)
+
+    @Insert(onConflict = OnConflictStrategy.IGNORE)
+    suspend fun insertIgnore(version: GalleryVersion)
+
+    @Query(
+        "SELECT * FROM gallery_version WHERE root_gid = " +
+            "(SELECT root_gid FROM gallery_version WHERE gid = :gid) ORDER BY detected_at"
+    )
+    suspend fun versionsOf(gid: Int): List<GalleryVersion>
+
+    @Query("SELECT COALESCE(MAX(detected_at), 0) FROM gallery_version")
+    suspend fun lastDetectedAt(): Long
+
+    @Query("SELECT COUNT(*) FROM gallery_version")
+    suspend fun count(): Int
+}
+

+package com.hippo.ehviewer.ui.settings
+
+import androidx.compose.animation.AnimatedVisibilityScope
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Scaffold
+import androidx.compose.material3.Text
+import androidx.compose.material3.TopAppBar
+import androidx.compose.material3.TopAppBarDefaults
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.input.nestedscroll.nestedScroll
+import androidx.compose.ui.unit.dp
+import com.hippo.ehviewer.ExlPrefs
+import com.hippo.ehviewer.Settings
+import com.hippo.ehviewer.asMutableState
+import com.hippo.ehviewer.collectAsState
+import com.hippo.ehviewer.ui.Screen
+import com.hippo.ehviewer.ui.destinations.FeedSubScreenDestination
+import com.hippo.ehviewer.ui.destinations.FilterScreenDestination
+import com.hippo.ehviewer.ui.destinations.HideListScreenDestination
+import com.hippo.ehviewer.ui.destinations.QuickSearchManagerScreenDestination
+import com.hippo.ehviewer.ui.destinations.TasksScreenDestination
+import com.hippo.ehviewer.ui.destinations.WatchListScreenDestination
+import com.hippo.ehviewer.ui.main.NavigationIcon
+import com.hippo.ehviewer.ui.tools.awaitInputText
+import com.ramcosta.composedestinations.annotation.Destination
+import com.ramcosta.composedestinations.annotation.RootGraph
+import com.ramcosta.composedestinations.navigation.DestinationsNavigator
+import kotlinx.coroutines.launch
+import me.zhanghai.compose.preference.Preference
+import me.zhanghai.compose.preference.SwitchPreference
+
+/**
+ * ExL 增强：自有功能的单页收口。
+ * 分区：服务端 / 屏蔽与过滤（含列表显示矩阵）/ 关注与订阅 / 工具。
+ */
+@Destination<RootGraph>
+@Composable
+fun AnimatedVisibilityScope.ExlSettingsScreen(navigator: DestinationsNavigator) = Screen(navigator) {
+    val scrollBehavior = TopAppBarDefaults.pinnedScrollBehavior()
+    val scope = rememberCoroutineScope()
+
+    val pqUrl by Settings.pqUrl.collectAsState()
+    val apiToken by Settings.apiToken.collectAsState()
+    val sapiUrl by Settings.sapiUrl.collectAsState()
+    val papiUrl by Settings.papiUrl.collectAsState()
+    val addKeyword by Settings.addKeyword.collectAsState()
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text("ExL 增强") },
+                navigationIcon = { NavigationIcon() },
+                scrollBehavior = scrollBehavior,
+            )
+        },
+    ) { padding ->
+        Column(
+            modifier = Modifier
+                .verticalScroll(rememberScrollState())
+                .padding(padding),
+        ) {
+            SectionTitle("服务端")
+            Preference(title = "服务端地址", summary = pqUrl ?: "未设置") {
+                scope.launch {
+                    val input = awaitInputText(initial = pqUrl.orEmpty(), title = "服务端地址", hint = "https://exl.loliwant.cc")
+                    Settings.pqUrl.value = input.trim().ifBlank { null }
+                }
+            }
+            Preference(title = "API Token", summary = apiToken?.let { "已配置 (${it.take(4)}…)" } ?: "未设置") {
+                scope.launch {
+                    val input = awaitInputText(initial = apiToken.orEmpty(), title = "API Token", hint = "留空表示服务端不鉴权")
+                    Settings.apiToken.value = input.trim().ifBlank { null }
+                }
+            }
+            SwitchPreference(
+                title = "同步收藏到服务端",
+                summary = "收藏 / 取消收藏后上报，让下载器知道该下什么",
+                state = Settings.syncFav.asMutableState(),
+            )
+            Preference(title = "SAPI 地址", summary = sapiUrl ?: "未设置") {
+                scope.launch {
+                    val input = awaitInputText(initial = sapiUrl.orEmpty(), title = "SAPI 地址")
+                    Settings.sapiUrl.value = input.trim().ifBlank { null }
+                }
+            }
+            Preference(title = "PAPI 地址", summary = papiUrl ?: "未设置") {
+                scope.launch {
+                    val input = awaitInputText(initial = papiUrl.orEmpty(), title = "PAPI 地址")
+                    Settings.papiUrl.value = input.trim().ifBlank { null }
+                }
+            }
+            Preference(title = "快捷附加关键词", summary = addKeyword ?: "未设置") {
+                scope.launch {
+                    val input = awaitInputText(initial = addKeyword.orEmpty(), title = "快捷附加关键词")
+                    Settings.addKeyword.value = input.trim().ifBlank { null }
+                }
+            }
+
+            SectionTitle("屏蔽与过滤")
+            Preference(title = "屏蔽规则（过滤）", summary = "标题 / 上传者 / 标签 / 复合标签 …") {
+                navigator.navigate(FilterScreenDestination())
+            }
+            Preference(title = "隐藏规则", summary = "跨端同步的隐藏列表") {
+                navigator.navigate(HideListScreenDestination())
+            }
+            Preference(title = "关注列表", summary = "被关注的作者 / 社团 / 标签 / 标题") {
+                navigator.navigate(WatchListScreenDestination())
+            }
+
+            SectionTitle("列表显示（隐藏矩阵）")
+            SwitchPreference(
+                title = "普通列表隐藏「下载优先」画廊",
+                state = ExlPrefs.hidePqInList.asMutableState(),
+            )
+            SwitchPreference(
+                title = "普通列表隐藏「优先订阅」画廊",
+                state = ExlPrefs.hideFeedInList.asMutableState(),
+            )
+            SwitchPreference(
+                title = "普通列表隐藏「关注」画廊",
+                state = ExlPrefs.hideWatchInList.asMutableState(),
+            )
+            SwitchPreference(
+                title = "普通列表隐藏已收藏",
+                summary = "仅在本页条目 > 10 时生效，避免整页清空",
+                state = Settings.hideFav.asMutableState(),
+            )
+            SwitchPreference(
+                title = "历史记录隐藏「下载优先」画廊",
+                state = ExlPrefs.hidePqInHistory.asMutableState(),
+            )
+            SwitchPreference(
+                title = "历史记录隐藏「优先订阅」画廊",
+                state = ExlPrefs.hideFeedInHistory.asMutableState(),
+            )
+            SwitchPreference(
+                title = "历史记录隐藏「关注」画廊",
+                state = ExlPrefs.hideWatchInHistory.asMutableState(),
+            )
+            SwitchPreference(
+                title = "历史记录隐藏已收藏",
+                state = Settings.hideFavInHistory.asMutableState(),
+            )
+
+            SectionTitle("关注与订阅")
+            Preference(title = "优先订阅", summary = "下载优先队列里标签类型抓取的新作品") {
+                navigator.navigate(FeedSubScreenDestination())
+            }
+
+            SectionTitle("工具")
+            Preference(title = "任务中心", summary = "批量收藏等任务的进度 / 取消 / 排队") {
+                navigator.navigate(TasksScreenDestination())
+            }
+            Preference(title = "快速搜索管理", summary = "搜索定位 / 智能排序 / 置顶 / 分类") {
+                navigator.navigate(QuickSearchManagerScreenDestination())
+            }
+        }
+    }
+}
+
+@Composable
+private fun SectionTitle(text: String) {
+    Text(
+        text = text,
+        style = MaterialTheme.typography.titleSmall,
+        color = MaterialTheme.colorScheme.primary,
+        modifier = Modifier.padding(start = 16.dp, top = 16.dp, bottom = 4.dp),
+    )
+}
+

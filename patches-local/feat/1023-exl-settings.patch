+package com.hippo.ehviewer
+
+import com.ehviewer.core.preferences.DataStorePreferences
+
+/**
+ * ExL 自有偏好项（不写进 Settings，避免每次补丁都动同一个大文件）。
+ *
+ * 分组：
+ * - 列表显示矩阵：来源（下载优先 / 优先订阅 / 关注）× 列表（普通列表 / 历史）
+ * - 版本与订阅行为
+ */
+object ExlPrefs : DataStorePreferences("exl_prefs") {
+    // ===== 列表显示矩阵 =====
+    val hidePqInList = boolPref("hide_pq_in_list", true)
+    val hideFeedInList = boolPref("hide_feed_in_list", true)
+    val hideWatchInList = boolPref("hide_watch_in_list", false)
+
+    val hidePqInHistory = boolPref("hide_pq_in_history", false)
+    val hideFeedInHistory = boolPref("hide_feed_in_history", false)
+    val hideWatchInHistory = boolPref("hide_watch_in_history", false)
+
+    // ===== 下载优先页 =====
+    val pqSortByUpdated = boolPref("pq_sort_by_updated", false)
+    val pqSortDesc = boolPref("pq_sort_desc", true)
+    val pqHideFav = boolPref("pq_hide_fav", false)
+
+    // ===== 优先订阅页 =====
+    val feedHideFav = boolPref("feed_hide_fav", true)
+    val feedHideTranslated = boolPref("feed_hide_translated", true)
+
+    // ===== 版本迁移 =====
+    // 本地收藏跟随新版：发现 current_gid 变化时把收藏行复制到新 gid
+    val followRenamedFav = boolPref("follow_renamed_fav", true)
+    // 已有下载发现新版时的策略：only-notify / auto-redownload / ignore
+    val renamedDownloadPolicy = stringPref("renamed_download_policy", "only-notify")
+}
+

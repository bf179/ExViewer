+package com.ehviewer.core.database.dao
+
+import androidx.room.Dao
+import androidx.room.Insert
+import androidx.room.Query
+import com.ehviewer.core.database.model.SyncOutbox
+import kotlinx.coroutines.flow.Flow
+
+@Dao
+interface SyncOutboxDao {
+    @Query("SELECT * FROM sync_outbox ORDER BY createdAt ASC")
+    suspend fun list(): List<SyncOutbox>
+
+    @Query("SELECT COUNT(*) FROM sync_outbox")
+    suspend fun count(): Int
+
+    @Query("SELECT COUNT(*) FROM sync_outbox")
+    fun countFlow(): Flow<Int>
+
+    @Insert
+    suspend fun insert(item: SyncOutbox): Long
+
+    @Query("DELETE FROM sync_outbox WHERE id = :id")
+    suspend fun deleteById(id: Long)
+
+    @Query("DELETE FROM sync_outbox")
+    suspend fun clear()
+}

+package com.ehviewer.core.database.dao
+
+import androidx.room.Dao
+import androidx.room.Insert
+import androidx.room.Query
+import androidx.room.Update
+import com.ehviewer.core.database.model.BatchFavTask
+import kotlinx.coroutines.flow.Flow
+
+@Dao
+interface BatchFavTaskDao {
+    @Insert
+    suspend fun insert(task: BatchFavTask): Long
+
+    @Update
+    suspend fun update(task: BatchFavTask)
+
+    @Query("SELECT * FROM batch_fav_tasks WHERE id = :id")
+    suspend fun getById(id: Long): BatchFavTask?
+
+    @Query("SELECT * FROM batch_fav_tasks ORDER BY createdAt DESC LIMIT 1")
+    suspend fun latest(): BatchFavTask?
+
+    @Query("SELECT * FROM batch_fav_tasks WHERE status IN ('running', 'interrupted') ORDER BY createdAt DESC")
+    suspend fun resumable(): List<BatchFavTask>
+
+    @Query("SELECT * FROM batch_fav_tasks ORDER BY createdAt DESC")
+    fun listFlow(): Flow<List<BatchFavTask>>
+
+    @Query("DELETE FROM batch_fav_tasks WHERE id = :id")
+    suspend fun deleteById(id: Long)
+
+    @Query("DELETE FROM batch_fav_tasks WHERE status = 'done'")
+    suspend fun clearDone()
+}

+
+/**
+ * 快速搜索管理：
+ * - 搜索定位（按名称 / 关键词过滤）
+ * - 智能排序（置顶 → 使用次数 → 最近使用；关闭则按手动顺序）
+ * - 置顶 / 取消置顶、删除
+ * - 智能分类（按搜索模式分组显示）
+ */
+@Destination<RootGraph>
+@Composable
+fun AnimatedVisibilityScope.QuickSearchManagerScreen(navigator: DestinationsNavigator) = Screen(navigator) {
+    val scrollBehavior = TopAppBarDefaults.pinnedScrollBehavior()
+    val scope = rememberCoroutineScope()
+    val all = remember { mutableStateListOf<QuickSearch>() }
+    val filter = rememberTextFieldState()
+    val smartSort by Settings.smartQuickSearchSort.collectAsState()
+    val query = filter.text.toString().trim()
+
+    suspend fun reload() {
+        val list = if (smartSort) {
+            EhDB.quickSearchDao().listSmart()
+        } else {
+            EhDB.quickSearchDao().list()
+        }
+        all.clear()
+        all.addAll(list)
+    }
+
+    LaunchedEffect(smartSort) { reload() }
+
+    val shown = if (query.isBlank()) {
+        all.toList()
+    } else {
+        all.filter { it.name.contains(query, true) || (it.keyword ?: "").contains(query, true) }
+    }
+    val grouped = shown.groupBy { modeLabel(it.mode) }
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text(text = "快速搜索管理") },
+                navigationIcon = { NavigationIcon() },
+                scrollBehavior = scrollBehavior,
+            )
+        },
+    ) { paddingValues ->
+        LazyColumn(
+            modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+            contentPadding = paddingValues,
+        ) {
+            item(key = "smart") {
+                SwitchPreference(
+                    title = "智能排序",
+                    summary = "置顶优先，其次按使用次数与最近使用时间",
+                    state = Settings.smartQuickSearchSort.asMutableState(),
+                )
+            }
+            item(key = "search") {
+                OutlinedTextField(
+                    state = filter,
+                    label = { Text(text = "搜索定位") },
+                    lineLimits = TextFieldLineLimits.SingleLine,
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp),
+                )
+            }
+            grouped.forEach { (label, list) ->
+                item(key = "h_$label") {
+                    Text(
+                        text = label,
+                        style = MaterialTheme.typography.titleSmall,
+                        modifier = Modifier.padding(start = 16.dp, top = 12.dp, bottom = 4.dp),
+                    )
+                }
+                items(list, key = { it.id ?: it.name.hashCode().toLong() }) { q ->
+                    Row(
+                        modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 6.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                    ) {
+                        Column(modifier = Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(2.dp)) {
+                            Text(text = q.name, maxLines = 1, overflow = TextOverflow.Ellipsis)
+                            Text(
+                                text = "${q.keyword.orEmpty()} · 用过 ${q.useCount} 次" +
+                                    if (q.pinned) " · 已置顶" else "",
+                                style = MaterialTheme.typography.bodySmall,
+                                maxLines = 1,
+                                overflow = TextOverflow.Ellipsis,
+                            )
+                        }
+                        IconButton(onClick = {
+                            scope.launch {
+                                q.id?.let { EhDB.quickSearchDao().setPinned(it, !q.pinned) }
+                                reload()
+                            }
+                        }) {
+                            Icon(imageVector = Icons.Default.PushPin, contentDescription = if (q.pinned) "取消置顶" else "置顶")
+                        }
+                        IconButton(onClick = {
+                            scope.launch {
+                                EhDB.deleteQuickSearch(q)
+                                reload()
+                            }
+                        }) {
+                            Icon(imageVector = Icons.Default.Delete, contentDescription = "删除")
+                        }
+                    }
+                }
+            }
+            if (shown.isEmpty()) {
+                item { Text(text = "没有匹配的快速搜索", modifier = Modifier.padding(24.dp)) }
+            }
+        }
+    }
+}
+
+private fun modeLabel(mode: Int): String = when (mode) {
+    0 -> "普通搜索"
+    1 -> "标签搜索"
+    2 -> "上传者搜索"
+    3 -> "订阅"
+    else -> "其他"
+}
